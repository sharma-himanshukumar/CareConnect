,

{
  "chunk_id": "p6_billing_guidelines_bed_charges",
  "page_number": 6,
  "type": "billing_guideline_item",
  "main_title": "BILLING GUIDELINES",
  "sub_title": "Bed Charges",
  "content": [
    "Charges shall be levied as per rates applicable. Room rent includes laundry charges, patient’s diet (as prescribed) and housekeeping services only.",
    "Nursing charges, Resident medical charges (RMO) and dietician charges would be charged extra.",
    "The billing starts from the time of admission.",
    "Procedures, Surgeries, Packages & Doctor Visit, etc. shall be charged according to the respective room category opted for as mentioned. A stay beyond 8 hrs shall attract full day room rent. 24 hrs billing cycle on room rent shall be applicable."
  ]
}
,

{
  "chunk_id": "p6_billing_guidelines_bed_transfer",
  "page_number": 6,
  "type": "billing_guideline_item",
  "main_title": "BILLING GUIDELINES",
  "sub_title": "Bed Transfer",
  "content": [
    "In the event of a bed transfer during the course of treatment, the higher category bed charges shall be applicable from the day of transfer.",
    "In the event of a bed transfer from the lower bed category to higher bed category during the course of treatment, the Surgery/packages would be charged as per higher bed category.",
    "For all procedures, surgeries, diagnostic services, and all other services rendered while the patient is in the wards, billing is always done at the current bed category charges.",
    "Overnight stay shall be charge as per higher room category."
  ]
}
,

{
  "chunk_id": "p7_billing_guidelines_critical_care",
  "page_number": 7,
  "type": "billing_guideline_item",
  "main_title": "BILLING GUIDELINES",
  "sub_title": "Admission Directly into Critical Care",
  "content": [
    "In case patient is admitted to HDU/CCA bed directly, the charges for procedure/surgeries shall be as per the charges applicable to the semi-private room.",
    "Charges for any services performed in HDU / CCA will be equivalent to semi-private room."
  ]
}
,

{
  "chunk_id": "p7_billing_guidelines_ot_anaesthesia",
  "page_number": 7,
  "type": "billing_guideline_item",
  "main_title": "BILLING GUIDELINES",
  "sub_title": "Billing of OT & Anaesthesia Services Procedure / Surgery Charges",
  "content": [
    "The charges for any Procedure/Surgery shall be according to the Schedule of Charges.",
    "Operation charges (100%) / Cath Lab Charges (40%) and Anaesthesia Charges (35%) would be charged over and above procedure charges.",
    "Assistant surgeon charges (30%) and any instrument charges will be charged extra (if used).",
    "The Charges for Procedures includes Surgeon Fee only.",
    "For all packages/procedures/surgery/operations, the medicines/consumables/implants are charged extra separately.",
    "Operations and Procedures done during emergency and hospital holidays would be charged at 25% extra.",
    "High risk surgeries will be charged at 15% more than the usual charges."
  ]
}
,

